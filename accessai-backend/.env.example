# AccessAI Backend - Production Environment Variables Template
# Copy this file to .env and configure your values

# Server Port
PORT=5000

# CORS Allowed Origins
CORS_ORIGIN=https://accessai-frontend.vercel.app,http://localhost:3000,http://localhost:3001

# AI Service Configuration (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (SQLite path)
DATABASE_PATH=./data/accessai.db
