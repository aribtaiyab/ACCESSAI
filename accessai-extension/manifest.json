{
  "manifest_version": 3,
  "name": "AccessAI",
  "version": "2.0.0",
  "description": "AI accessibility companion to simplify, explain, summarize, translate, and ask questions on any webpage.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://accessai-backend-lx57.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AccessAI — AI Accessibility Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "MacCtrl+Shift+A"
      },
      "description": "Open AccessAI Assistant"
    }
  }
}